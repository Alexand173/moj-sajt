{
  "crons": [
    {
      "path": "/api/cron/enrich-news",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/enrich-news?scope=official",
      "schedule": "0 4 * * *"
    }
  ]

"headers": [
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    }
  ]
}










