    },
    "var_dde26c025eeb": {
      "type": "variant",
      "label": "Tour Profile Hero — Five Image Slideshow",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 5520,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap');\n\n  :root {\n    --ink: #08090a;\n    --red: #e63946;\n    --muted: #64748b;\n    --white: #ffffff;\n  }\n\n  body {\n    margin: 0;\n    min-width: 320px;\n    background: var(--ink);\n    color: var(--white);\n    font-family: 'Inter', Arial, sans-serif;\n  }\n\n  .tour-hero {\n    position: relative;\n    min-height: 704px;\n    width: 100%;\n    overflow: hidden;\n    background: var(--ink);\n    isolation: isolate;\n  }\n\n  .tour-hero__slides,\n  .tour-hero__slide,\n  .tour-hero__overlay {\n    position: absolute;\n    inset: 0;\n  }\n\n  .tour-hero__slide {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    filter: grayscale(1);\n    opacity: 0;\n    transition: opacity 1000ms ease;\n  }\n\n  .tour-hero__slide.is-active { opacity: 1; }\n\n  .tour-hero__overlay {\n    z-index: 2;\n    background: linear-gradient(to top, rgb(8 9 10), rgb(8 9 10 / 62%) 48%, rgb(8 9 10 / 18%));\n    pointer-events: none;\n  }\n\n  .tour-hero__indicator-row {\n    position: absolute;\n    top: 32px;\n    right: 64px;\n    left: 64px;\n    z-index: 5;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 24px;\n  }\n\n  .tour-hero__indicators {\n    display: flex;\n    gap: 6px;\n  }\n\n  .tour-hero__indicator {\n    width: 20px;\n    height: 2px;\n    background: rgb(255 255 255 / 45%);\n    transition: width 500ms ease, background-color 500ms ease;\n  }\n\n  .tour-hero__indicator.is-active {\n    width: 48px;\n    background: var(--red);\n  }\n\n  .tour-hero__cycle {\n    color: rgb(255 255 255 / 52%);\n    font-family: 'SFMono-Regular', Consolas, monospace;\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n  }\n\n  .tour-hero__content {\n    position: relative;\n    z-index: 4;\n    display: flex;\n    min-height: 704px;\n    width: min(100%, 1600px);\n    margin: 0 auto;\n    align-items: flex-end;\n    padding: 0 64px 56px;\n  }\n\n  .tour-hero__copy { max-width: 960px; }\n\n  .tour-hero__back {\n    display: inline-flex;\n    padding-bottom: 8px;\n    border-bottom: 1px solid rgb(255 255 255 / 50%);\n    color: rgb(255 255 255 / 72%);\n    font-size: 10px;\n    font-weight: 900;\n    letter-spacing: .25em;\n    text-decoration: none;\n    text-transform: uppercase;\n  }\n\n  .tour-hero__kicker {\n    margin: 24px 0 0;\n    color: var(--red);\n    font-size: 10px;\n    font-weight: 900;\n    letter-spacing: .28em;\n    text-transform: uppercase;\n  }\n\n  .tour-hero__title {\n    max-width: 1000px;\n    margin: 12px 0 0;\n    color: var(--white);\n    font-size: clamp(56px, 9vw, 136px);\n    font-weight: 900;\n    letter-spacing: -.085em;\n    line-height: .82;\n  }\n\n  .tour-hero__tagline {\n    max-width: 620px;\n    margin: 22px 0 0;\n    color: rgb(255 255 255 / 70%);\n    font-size: 17px;\n    line-height: 1.5;\n  }\n\n  .tour-hero__sr-only {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n    border: 0;\n  }\n\n  @media (max-width: 700px) {\n    .tour-hero { min-height: 512px; }\n    .tour-hero__content { min-height: 512px; padding: 0 24px 40px; }\n    .tour-hero__indicator-row { top: 24px; right: 24px; left: 24px; }\n    .tour-hero__cycle { font-size: 8px; }\n    .tour-hero__title { max-width: 350px; font-size: clamp(52px, 15vw, 72px); line-height: .84; }\n    .tour-hero__tagline { max-width: 330px; margin-top: 16px; font-size: 14px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .tour-hero__slide,\n    .tour-hero__indicator { transition: none; }\n  }\n</style>\n<section aria-label=\"Metallica tour images\" aria-roledescription=\"carousel\" class=\"tour-hero\" data-kid=\"1\" data-name=\"tour hero section\" role=\"region\">\n    <div aria-hidden=\"true\" class=\"tour-hero__slides\" data-kid=\"1-1\" data-name=\"carousel images container\">\n        <img alt=\"Metallica tour image 1\" class=\"tour-hero__slide is-active\" data-dynamic=\"true\" data-kid=\"1-1-1\" data-name=\"active tour image\" data-reason=\"active class and alt text toggled by script\" data-slide=\"0\" decoding=\"async\" loading=\"eager\" src=\"https://i.ytimg.com/vi/6f5SsjjrSp0/hqdefault.jpg\"/>\n        <img alt=\"\" class=\"tour-hero__slide\" data-dynamic=\"true\" data-kid=\"1-1-2\" data-name=\"inactive tour image\" data-reason=\"active class and alt text toggled by script\" data-slide=\"1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1470229722913-7c0e2dbbafd3?auto=format&fit=crop&w=1800&q=85\"/>\n        <img alt=\"\" class=\"tour-hero__slide\" data-dynamic=\"true\" data-kid=\"1-1-3\" data-name=\"inactive tour image\" data-reason=\"active class and alt text toggled by script\" data-slide=\"2\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1501386761578-eac5c94b800a?auto=format&fit=crop&w=1800&q=85\"/>\n        <img alt=\"\" class=\"tour-hero__slide\" data-dynamic=\"true\" data-kid=\"1-1-4\" data-name=\"inactive tour image\" data-reason=\"active class and alt text toggled by script\" data-slide=\"3\" decoding=\"async\" loading=\"lazy\" src=\"https://upload.wikimedia.org/wikipedia/commons/4/4b/James_Hetfield_2017.jpg\"/>\n        <img alt=\"\" class=\"tour-hero__slide\" data-dynamic=\"true\" data-kid=\"1-1-5\" data-name=\"inactive tour image\" data-reason=\"active class and alt text toggled by script\" data-slide=\"4\" decoding=\"async\" loading=\"lazy\" src=\"https://upload.wikimedia.org/wikipedia/commons/6/6f/Kirk_Hammett_2017.jpg\"/>\n    </div>\n    <div class=\"tour-hero__overlay\" data-kid=\"1-2\" data-name=\"dark gradient overlay\">\n    </div>\n    <div aria-hidden=\"true\" class=\"tour-hero__indicator-row\" data-kid=\"1-3\" data-name=\"indicator row container\">\n        <div class=\"tour-hero__indicators\" data-kid=\"1-3-1\" data-name=\"carousel indicators container\">\n            <span class=\"tour-hero__indicator is-active\" data-dynamic=\"true\" data-kid=\"1-3-1-1\" data-name=\"active indicator dot\" data-reason=\"active class toggled by script\">\n            </span>\n            <span class=\"tour-hero__indicator\" data-dynamic=\"true\" data-kid=\"1-3-1-2\" data-name=\"inactive indicator dot\" data-reason=\"active class toggled by script\">\n            </span>\n            <span class=\"tour-hero__indicator\" data-dynamic=\"true\" data-kid=\"1-3-1-3\" data-name=\"inactive indicator dot\" data-reason=\"active class toggled by script\">\n            </span>\n            <span class=\"tour-hero__indicator\" data-dynamic=\"true\" data-kid=\"1-3-1-4\" data-name=\"inactive indicator dot\" data-reason=\"active class toggled by script\">\n            </span>\n            <span class=\"tour-hero__indicator\" data-dynamic=\"true\" data-kid=\"1-3-1-5\" data-name=\"inactive indicator dot\" data-reason=\"active class toggled by script\">\n            </span>\n        </div>\n        <span class=\"tour-hero__cycle\" data-kid=\"1-3-2\" data-name=\"auto-cycle status text\">\n            Auto-cycle · 30 sec\n        </span>\n    </div>\n    <div class=\"tour-hero__content\" data-kid=\"1-4\" data-name=\"hero content container\">\n        <div class=\"tour-hero__copy\" data-kid=\"1-4-1\" data-name=\"hero copy block\">\n            <a class=\"tour-hero__back\" data-kid=\"1-4-1-1\" data-name=\"back to all tours link\" href=\"#\">\n                ← ALL TOURS\n            </a>\n            <p class=\"tour-hero__kicker\" data-kid=\"1-4-1-2\" data-name=\"tour kicker text\">\n                OFFICIAL TOUR · 63 DATES\n            </p>\n            <h1 class=\"tour-hero__title\" data-kid=\"1-4-1-3\" data-name=\"hero title text\">\n                Metallica: Life Burns Faster\n            </h1>\n            <p class=\"tour-hero__tagline\" data-kid=\"1-4-1-4\" data-name=\"hero tagline text\">\n                Four cities. Four nights. The heaviest tour of the year.\n            </p>\n        </div>\n    </div>\n    <p aria-live=\"polite\" class=\"tour-hero__sr-only\" data-dynamic=\"true\" data-kid=\"1-5\" data-name=\"screen reader live region\" data-reason=\"text content updated by script\">\n        Showing tour image 1 of 5 for Metallica.\n    </p>\n</section>\n<script>\n    (() => {\n    const slides = Array.from(document.querySelectorAll('.tour-hero__slide'));\n    const indicators = Array.from(document.querySelectorAll('.tour-hero__indicator'));\n    const live = document.querySelector('.tour-hero__sr-only');\n    let activeIndex = 0;\n\n    const showSlide = (nextIndex) => {\n      activeIndex = nextIndex % slides.length;\n      slides.forEach((slide, index) => {\n        const isActive = index === activeIndex;\n        slide.classList.toggle('is-active', isActive);\n        slide.setAttribute('aria-hidden', String(!isActive));\n        slide.alt = isActive ? `Metallica tour image ${index + 1}` : '';\n      });\n      indicators.forEach((indicator, index) => indicator.classList.toggle('is-active', index === activeIndex));\n      if (live) live.textContent = `Showing tour image ${activeIndex + 1} of ${slides.length} for Metallica.`;\n    };\n\n    window.setInterval(() => showSlide(activeIndex + 1), 30000);\n  })();\n</script>\n",
