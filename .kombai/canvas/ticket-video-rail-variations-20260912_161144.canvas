      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n  .ticket-strip-body { font-family: 'Inter', sans-serif; }\n</style>\n<div class=\"ticket-strip-body min-h-[720px] bg-[#fbfcfe] text-[#08090a]\" data-kid=\"1\">\n    <div class=\"mx-auto w-[min(1180px,calc(100%-80px))] pt-14\" data-kid=\"1-1\">\n        <div class=\"mb-5 flex items-center justify-between\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-4 text-[10px] font-black uppercase tracking-[0.32em] text-[#e63946]\" data-kid=\"1-1-1-1\">\n                <span class=\"h-px w-10 bg-[#e63946]\" data-kid=\"1-1-1-1-1\">\n                </span>\n                <span data-kid=\"1-1-1-1-2\">\n                    On the road · 2026\n                </span>\n            </div>\n            <div class=\"flex items-center gap-2 text-[9px] font-bold uppercase tracking-[0.22em] text-[#64748b]\" data-kid=\"1-1-1-2\">\n                <span class=\"h-2 w-2 rounded-full bg-[#e63946] shadow-[0_0_0_4px_rgba(230,57,70,0.13)]\" data-kid=\"1-1-1-2-1\">\n                </span>\n                US live desk\n            </div>\n        </div>\n        <section class=\"relative h-[420px] overflow-hidden rounded-[3px] bg-[#08090a] text-white shadow-[0_16px_38px_rgba(8,9,10,0.18)]\" data-kid=\"1-1-2\">\n            <img alt=\"\" class=\"absolute inset-0 h-full w-full object-cover opacity-[0.48]\" data-kid=\"1-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/6f5SsjjrSp0/maxresdefault.jpg\"/>\n            <div class=\"absolute inset-0 bg-[linear-gradient(90deg,rgba(0,0,0,0.92),rgba(0,0,0,0.2)_66%,rgba(0,0,0,0.48)),linear-gradient(0deg,rgba(0,0,0,0.96),transparent_56%)]\" data-kid=\"1-1-2-2\">\n            </div>\n            <div class=\"absolute inset-x-7 top-6 z-10 flex items-center justify-between text-[9px] font-black uppercase tracking-[0.18em]\" data-kid=\"1-1-2-3\">\n                <span class=\"flex items-center gap-2\" data-kid=\"1-1-2-3-1\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#e63946] shadow-[0_0_0_4px_rgba(230,57,70,0.16)]\" data-kid=\"1-1-2-3-1-1\">\n                    </span>\n                    Live broadcast\n                </span>\n                <span class=\"text-white/60\" data-kid=\"1-1-2-3-2\">\n                    ⌁ MusicTop · Stage 1\n                </span>\n            </div>\n            <div class=\"absolute left-8 top-[112px] z-10 max-w-[520px]\" data-kid=\"1-1-2-4\">\n                <div class=\"mb-3 text-[10px] font-black uppercase tracking-[0.28em] text-[#e63946]\" data-kid=\"1-1-2-4-1\">\n                    Now playing\n                </div>\n                <h1 class=\"text-[48px] font-black leading-[0.92] tracking-[-0.075em]\" data-kid=\"1-1-2-4-2\">\n                    Metallica: Life Burns Faster\n                </h1>\n                <p class=\"mt-3 text-[13px] font-medium text-white/85\" data-kid=\"1-1-2-4-3\">\n                    Official YouTube video\n                </p>\n                <p class=\"mt-1 text-[10px] font-bold uppercase tracking-[0.18em] text-white/55\" data-kid=\"1-1-2-4-4\">\n                    Sphere · Las Vegas\n                </p>\n            </div>\n            <div class=\"absolute left-1/2 top-[43%] z-10 flex h-14 w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-[4px] bg-[#e63946] shadow-[0_8px_28px_rgba(230,57,70,0.34)]\" data-kid=\"1-1-2-5\">\n                <span class=\"ml-1 text-[23px] leading-none text-white\" data-kid=\"1-1-2-5-1\">\n                    ▶\n                </span>\n            </div>\n            <div class=\"absolute inset-x-7 bottom-7 z-20\" data-kid=\"1-1-2-6\">\n                <div class=\"relative overflow-hidden\" data-kid=\"1-1-2-6-1\">\n                    <div class=\"flex w-max gap-2 pr-[184px]\" data-dynamic=\"true\" data-kid=\"1-1-2-6-1-1\" data-name=\"video list wrapper\" data-reason=\"video order and selection reinitialized by script\" dir=\"ltr\">\n                        <button class=\"relative flex h-[82px] w-[176px] shrink-0 overflow-hidden border-b-2 border-[#e63946] bg-[#fbfcfe] text-left text-[#08090a] shadow-[0_0_0_1px_rgba(230,57,70,0.18)]\" data-dynamic=\"true\" data-kid=\"1-1-2-6-1-1-1\" data-name=\"video selection card\" data-reason=\"style order property injected by script\" style=\"position:absolute;top:0;right:0;z-index:20\" type=\"button\">\n                            <span class=\"relative w-[54px] shrink-0 overflow-hidden bg-[#121212]\" data-kid=\"1-1-2-6-1-1-1-1\">\n                                <img alt=\"\" class=\"h-full w-full object-cover opacity-90\" data-kid=\"1-1-2-6-1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/6f5SsjjrSp0/hqdefault.jpg\"/>\n                                <span class=\"absolute inset-y-0 right-[-1px] border-r border-dashed border-[#e63946]\" data-kid=\"1-1-2-6-1-1-1-1-2\">\n                                </span>\n                                <span class=\"absolute -right-2 -top-2 h-4 w-4 rounded-full bg-[#08090a]\" data-kid=\"1-1-2-6-1-1-1-1-3\">\n                                </span>\n                                <span class=\"absolute -right-2 -bottom-2 h-4 w-4 rounded-full bg-[#08090a]\" data-kid=\"1-1-2-6-1-1-1-1-4\">\n                                </span>\n                            </span>\n                            <span class=\"relative flex min-w-0 flex-1 flex-col justify-end px-3 pb-2\" data-kid=\"1-1-2-6-1-1-1-2\">\n                                <span class=\"line-clamp-2 text-[11px] font-black leading-[1.02] tracking-[-0.04em]\" data-kid=\"1-1-2-6-1-1-1-2-1\">\n                                    Metallica: Life Burns Faster\n                                </span>\n                                <span class=\"mt-1 truncate text-[8px] font-bold uppercase tracking-[0.08em] text-[#64748b]\" data-kid=\"1-1-2-6-1-1-1-2-2\">\n                                    YouTube video\n                                </span>\n                                <span class=\"absolute right-2 top-2 h-2 w-2 rounded-full bg-[#e63946]\" data-kid=\"1-1-2-6-1-1-1-2-3\">\n                                </span>\n                            </span>\n                            <span class=\"absolute -right-1.5 top-1/2 h-3 w-3 -translate-y-1/2 rounded-full bg-[#e63946]\" data-kid=\"1-1-2-6-1-1-1-3\">\n                            </span>\n                        </button>\n                        <button class=\"relative flex h-[82px] w-[176px] shrink-0 overflow-hidden border border-white/35 bg-[#121212] text-left text-white\" data-kid=\"1-1-2-6-1-1-2\" type=\"button\">\n                            <span class=\"relative w-[54px] shrink-0 overflow-hidden bg-[#1a1c20]\" data-kid=\"1-1-2-6-1-1-2-1\">\n                                <img alt=\"\" class=\"h-full w-full object-cover opacity-65\" data-kid=\"1-1-2-6-1-1-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/yQK34fHQLJ0/hqdefault.jpg\"/>\n                                <span class=\"absolute inset-y-0 right-[-1px] border-r border-dashed border-[#64748b]\" data-kid=\"1-1-2-6-1-1-2-1-2\">\n                                </span>\n                                <span class=\"absolute -right-2 -top-2 h-4 w-4 rounded-full bg-[#08090a]\" data-kid=\"1-1-2-6-1-1-2-1-3\">\n                                </span>\n                                <span class=\"absolute -right-2 -bottom-2 h-4 w-4 rounded-full bg-[#08090a]\" data-kid=\"1-1-2-6-1-1-2-1-4\">\n                                </span>\n                            </span>\n                            <span class=\"flex min-w-0 flex-1 flex-col justify-end px-3 pb-2\" data-kid=\"1-1-2-6-1-1-2-2\">\n                                <span class=\"line-clamp-2 text-[11px] font-black leading-[1.02] tracking-[-0.04em]\" data-kid=\"1-1-2-6-1-1-2-2-1\">\n                                    Bruno Mars - The Romantic Tour\n                                </span>\n                                <span class=\"mt-1 truncate text-[8px] font-bold uppercase tracking-[0.08em] text-white/55\" data-kid=\"1-1-2-6-1-1-2-2-2\">\n                                    YouTube video\n                                </span>\n                            </span>\n                        </button>\n                        <button class=\"relative flex h-[82px] w-[176px] shrink-0 overflow-hidden border border-white/35 bg-[#121212] text-left text-white\" data-kid=\"1-1-2-6-1-1-3\" type=\"button\">\n                            <span class=\"relative w-[54px] shrink-0 overflow-hidden bg-[#1a1c20]\" data-kid=\"1-1-2-6-1-1-3-1\">\n                                <img alt=\"\" class=\"h-full w-full object-cover opacity-65\" data-kid=\"1-1-2-6-1-1-3-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/w54r_M6D0Lk/hqdefault.jpg\"/>\n                                <span class=\"absolute inset-y-0 right-[-1px] border-r border-dashed border-[#64748b]\" data-kid=\"1-1-2-6-1-1-3-1-2\">\n                                </span>\n                                <span class=\"absolute -right-2 -top-2 h-4 w-4 rounded-full bg-[#08090a]\" data-kid=\"1-1-2-6-1-1-3-1-3\">\n                                </span>\n                                <span class=\"absolute -right-2 -bottom-2 h-4 w-4 rounded-full bg-[#08090a]\" data-kid=\"1-1-2-6-1-1-3-1-4\">\n                                </span>\n                            </span>\n                            <span class=\"flex min-w-0 flex-1 flex-col justify-end px-3 pb-2\" data-kid=\"1-1-2-6-1-1-3-2\">\n                                <span class=\"line-clamp-2 text-[11px] font-black leading-[1.02] tracking-[-0.04em]\" data-kid=\"1-1-2-6-1-1-3-2-1\">\n                                    Harry Styles: Together, Together\n                                </span>\n                                <span class=\"mt-1 truncate text-[8px] font-bold uppercase tracking-[0.08em] text-white/55\" data-kid=\"1-1-2-6-1-1-3-2-2\">\n                                    YouTube video\n                                </span>\n                            </span>\n                        </button>\n                        <button class=\"relative flex h-[82px] w-[176px] shrink-0 overflow-hidden border border-white/35 bg-[#121212] text-left text-white\" data-kid=\"1-1-2-6-1-1-4\" type=\"button\">\n                            <span class=\"relative w-[54px] shrink-0 overflow-hidden bg-[#1a1c20]\" data-kid=\"1-1-2-6-1-1-4-1\">\n                                <img alt=\"\" class=\"h-full w-full object-cover opacity-65\" data-kid=\"1-1-2-6-1-1-4-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/N0ZUMWk6omY/hqdefault.jpg\"/>\n                                <span class=\"absolute inset-y-0 right-[-1px] border-r border-dashed border-[#64748b]\" data-kid=\"1-1-2-6-1-1-4-1-2\">\n                                </span>\n                                <span class=\"absolute -right-2 -top-2 h-4 w-4 rounded-full bg-[#08090a]\" data-kid=\"1-1-2-6-1-1-4-1-3\">\n                                </span>\n                                <span class=\"absolute -right-2 -bottom-2 h-4 w-4 rounded-full bg-[#08090a]\" data-kid=\"1-1-2-6-1-1-4-1-4\">\n                                </span>\n                            </span>\n                            <span class=\"flex min-w-0 flex-1 flex-col justify-end px-3 pb-2\" data-kid=\"1-1-2-6-1-1-4-2\">\n                                <span class=\"line-clamp-2 text-[11px] font-black leading-[1.02] tracking-[-0.04em]\" data-kid=\"1-1-2-6-1-1-4-2-1\">\n                                    BTS WORLD TOUR 'ARIRANG' IN LOS ANGELES\n                                </span>\n                                <span class=\"mt-1 truncate text-[8px] font-bold uppercase tracking-[0.08em] text-white/55\" data-kid=\"1-1-2-6-1-1-4-2-2\">\n                                    YouTube video\n                               