      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n  .liner-rail::-webkit-scrollbar { display: none; }\n  .liner-rail { scrollbar-width: none; -ms-overflow-style: none; }\n  .liner-entry { position: relative; }\n  .liner-entry::after { content: ''; position: absolute; inset: 0; pointer-events: none; border-right: 1px solid rgba(148,163,184,.42); }\n  .liner-entry.is-active { background: #121212; }\n  .liner-entry.is-active::before { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: #e63946; }\n  .liner-entry.is-active .liner-thumb { opacity: 1; box-shadow: inset 0 0 0 1px #e63946; }\n  .liner-entry.is-active .liner-corner { opacity: 1; }\n  .liner-corner { position: absolute; right: 10px; top: 10px; width: 9px; height: 9px; border-right: 1px solid #e63946; border-top: 1px solid #e63946; opacity: 0; }\n  .liner-fade { background: linear-gradient(90deg, #08090a 8%, rgba(8,9,10,.92) 37%, rgba(8,9,10,0) 100%); }\n  @media (prefers-reduced-motion: reduce) { .liner-entry { transition: none !important; } }\n</style>\n<div class=\"min-h-[680px] bg-[#fbfcfe] px-8 py-16 font-['Inter',sans-serif] text-[#08090a]\" data-kid=\"1\" data-name=\"main layout container\">\n    <div class=\"mx-auto w-full max-w-[1120px]\" data-kid=\"1-1\" data-name=\"event section wrapper\">\n        <div class=\"mb-5 flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"event meta header\">\n            <p class=\"flex items-center gap-3 text-[10px] font-extrabold uppercase tracking-[.3em] text-[#e63946]\" data-kid=\"1-1-1-1\" data-name=\"event year text label\">\n                <span class=\"h-px w-10 bg-current\" data-kid=\"1-1-1-1-1\" data-name=\"decorative horizontal rule\">\n                </span>\n                On the road · 2026\n            </p>\n            <p class=\"flex items-center gap-2 text-[9px] font-bold uppercase tracking-[.2em] text-[#64748b]\" data-kid=\"1-1-1-2\" data-name=\"live desk status indicator\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[#e63946] shadow-[0_0_0_4px_rgba(230,57,70,.15)]\" data-kid=\"1-1-1-2-1\" data-name=\"status pulse dot\">\n                </span>\n                US live desk\n            </p>\n        </div>\n        <section class=\"relative h-[430px] overflow-hidden rounded-[3px] bg-[#08090a] text-white shadow-[0_16px_40px_rgba(8,9,10,.16)]\" data-kid=\"1-1-2\" data-name=\"hero media player section\">\n            <img alt=\"\" class=\"absolute inset-0 h-full w-full object-cover opacity-[.33] scale-[1.8] blur-[1px]\" data-kid=\"1-1-2-1\" data-name=\"background hero image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/6f5SsjjrSp0/hqdefault.jpg\"/>\n            <div class=\"absolute inset-0 bg-[linear-gradient(90deg,rgba(0,0,0,.94),rgba(0,0,0,.2)_58%,rgba(0,0,0,.58)),linear-gradient(0deg,rgba(8,9,10,.98),transparent_64%)]\" data-kid=\"1-1-2-2\" data-name=\"hero overlay gradient\">\n            </div>\n            <div class=\"absolute inset-x-7 top-6 z-10 flex items-center justify-between text-[9px] font-black uppercase tracking-[.16em] text-white/80\" data-kid=\"1-1-2-3\" data-name=\"broadcast status bar\">\n                <span class=\"flex items-center gap-2\" data-kid=\"1-1-2-3-1\" data-name=\"live indicator label\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#e63946] shadow-[0_0_0_4px_rgba(230,57,70,.16)]\" data-kid=\"1-1-2-3-1-1\" data-name=\"live status pulse dot\">\n                    </span>\n                    Live broadcast\n                </span>\n                <span class=\"text-white/55\" data-kid=\"1-1-2-3-2\" data-name=\"channel info text\">\n                    ⌁ MusicTop · Stage 1\n                </span>\n            </div>\n            <div class=\"absolute left-7 top-[118px] z-10 max-w-[560px]\" data-kid=\"1-1-2-4\" data-name=\"event details overlay\">\n                <p class=\"text-[10px] font-black uppercase tracking-[.25em] text-[#e63946]\" data-kid=\"1-1-2-4-1\" data-name=\"now playing badge text\">\n                    Now playing\n                </p>\n                <h1 class=\"mt-2 text-[54px] font-black leading-[.9] tracking-[-.07em]\" data-kid=\"1-1-2-4-2\" data-name=\"hero event headline\">\n                    Metallica: Life Burns Faster\n                </h1>\n                <p class=\"mt-3 text-[13px] font-medium text-white/80\" data-kid=\"1-1-2-4-3\" data-name=\"media source description\">\n                    Official YouTube video\n                </p>\n                <p class=\"mt-2 text-[10px] font-bold uppercase tracking-[.14em] text-white/45\" data-kid=\"1-1-2-4-4\" data-name=\"event location text\">\n                    Sphere · Las Vegas\n                </p>\n            </div>\n            <div class=\"absolute left-1/2 top-[44%] z-10 flex h-14 w-14 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-[#08090a] shadow-[0_8px_25px_rgba(0,0,0,.28)]\" data-kid=\"1-1-2-5\" data-name=\"play icon container\">\n                <span class=\"ml-1 text-2xl\" data-kid=\"1-1-2-5-1\" data-name=\"play icon\">\n                    ▶\n                </span>\n            </div>\n            <div class=\"absolute inset-x-7 bottom-6 z-20\" data-kid=\"1-1-2-6\" data-name=\"video selector interface\">\n                <div class=\"mb-2 flex items-center justify-between border-t border-white/20 pt-2\" data-kid=\"1-1-2-6-1\" data-name=\"video index header\">\n                    <span class=\"text-[8px] font-bold uppercase tracking-[.2em] text-white/45\" data-kid=\"1-1-2-6-1-1\" data-name=\"index title label\">\n                        Official source index\n                    </span>\n                    <span class=\"text-[8px] font-bold uppercase tracking-[.16em] text-white/35\" data-kid=\"1-1-2-6-1-2\" data-name=\"swipe instructional text\">\n                        Swipe for more\n                    </span>\n                </div>\n                <div class=\"relative overflow-hidden bg-[#08090a]\" data-kid=\"1-1-2-6-2\" data-name=\"horizontal scroll container\">\n                    <div aria-label=\"Choose a video\" class=\"liner-rail flex snap-x snap-mandatory overflow-x-auto\" data-kid=\"1-1-2-6-2-1\" data-name=\"video list track\" dir=\"rtl\">\n                        <button aria-selected=\"true\" class=\"liner-entry is-active flex h-[76px] min-w-[188px] snap-start text-left text-white transition-colors duration-150\" data-kid=\"1-1-2-6-2-1-1\" data-name=\"active video button\" dir=\"ltr\" type=\"button\">\n                            <span class=\"liner-thumb relative block h-full w-12 shrink-0 overflow-hidden opacity-100\" data-kid=\"1-1-2-6-2-1-1-1\" data-name=\"video thumbnail container\">\n                                <img alt=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-6-2-1-1-1-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/6f5SsjjrSp0/hqdefault.jpg\"/>\n                                <span class=\"absolute inset-0 ring-1 ring-inset ring-[#e63946]\" data-kid=\"1-1-2-6-2-1-1-1-2\" data-name=\"active indicator border\">\n                                </span>\n                            </span>\n                            <span class=\"flex min-w-0 flex-1 flex-col justify-center px-3\" data-kid=\"1-1-2-6-2-1-1-2\" data-name=\"video info wrapper\">\n                                <strong class=\"line-clamp-2 text-[12px] font-black leading-[.96] tracking-[-.04em]\" data-kid=\"1-1-2-6-2-1-1-2-1\" data-name=\"video title text\">\n                                    Metallica: Life Burns Faster\n                                </strong>\n                                <small class=\"mt-2 truncate text-[8px] font-bold text-white/55\" data-kid=\"1-1-2-6-2-1-1-2-2\" data-name=\"video source label\">\n                                    YouTube video\n                                </small>\n                            </span>\n                            <span class=\"liner-corner\" data-kid=\"1-1-2-6-2-1-1-3\" data-name=\"corner active marker\">\n                            </span>\n                        </button>\n                        <button aria-selected=\"false\" class=\"liner-entry flex h-[76px] min-w-[188px] snap-start text-left text-white/85 transition-colors duration-150 hover:bg-[#121212]\" data-kid=\"1-1-2-6-2-1-2\" data-name=\"inactive video button\" dir=\"ltr\" type=\"button\">\n                            <span class=\"liner-thumb relative block h-full w-12 shrink-0 overflow-hidden opacity-55\" data-kid=\"1-1-2-6-2-1-2-1\" data-name=\"video thumbnail container\">\n                                <img alt=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-6-2-1-2-1-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/yQK34fHQLJ0/hqdefault.jpg\"/>\n                            </span>\n                            <span class=\"flex min-w-0 flex-1 flex-col justify-center px-3\" data-kid=\"1-1-2-6-2-1-2-2\" data-name=\"video info wrapper\">\n                                <strong class=\"line-clamp-2 text-[12px] font-black leading-[.96] tracking-[-.04em]\" data-kid=\"1-1-2-6-2-1-2-2-1\" data-name=\"video title text\">\n                                    Bruno Mars - The Romantic Tour\n                                </strong>\n                                <small class=\"mt-2 truncate text-[8px] font-bold text-white/50\" data-kid=\"1-1-2-6-2-1-2-2-2\" data-name=\"video source label\">\n                                    YouTube video\n                                </small>\n                            </span>\n                            <span class=\"liner-corner\" data-kid=\"1-1-2-6-2-1-2-3\" data-name=\"corner active marker\">\n                            </span>\n                        </button>\n                        <button aria-selected=\"false\" class=\"liner-entry flex h-[76px] min-w-[188px] snap-start text-left text-white/85 transition-colors duration-150 hover:bg-[#121212]\" data-kid=\"1-1-2-6-2-1-3\" data-name=\"inactive video button\" dir=\"ltr\" type=\"button\">\n                            <span class=\"liner-thumb relative block h-full w-12 shrink-0 overflow-hidden opacity-55\" data-kid=\"1-1-2-6-2-1-3-1\" data-name=\"video thumbnail container\">\n                                <img alt=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-6-2-1-3-1-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/w54r_M6D0Lk/hqdefault.jpg\"/>\n                            </span>\n                            <span class=\"flex min-w-0 flex-1 flex-col justify-center px-3\" data-kid=\"1-1-2-6-2-1-3-2\" data-name=\"video info wrapper\">\n                                <strong class=\"line-clamp-2 text-[12px] font-black leading-[.96] tracking-[-.04em]\" data-kid=\"1-1-2-6-2-1-3-2-1\" data-name=\"video title text\">\n                                    Harry Styles: Together, Together\n                                </strong>\n                                <small class=\"mt-2 truncate text-[8px] font-bold text-white/50\" data-kid=\"1-1-2-6-2-1-3-2-2\" data-name=\"video source label\">\n                                    YouTube video\n                                </small>\n                            </span>\n                            <span class=\"liner-corner\" data-kid=\"1-1-2-6-2-1-3-3\" data-name=\"corner active marker\">\n                            </span>\n                        </button>\n                        <button aria-selected=\"false\" class=\"liner-entry flex h-[76px] min-w-[188px] snap-start text-left text-white/85 transition-colors duration-150 hover:bg-[#121212]\" data-kid=\"1-1-2-6-2-1-4\" data-name=\"inactive video button\" dir=\"ltr\" type=\"button\">\n                            <span class=\"liner-thumb relative block h-full w-12 shrink-0 overflow-hidden opacity-55\" data-kid=\"1-1-2-6-2-1-4-1\" data-name=\"video thumbnail container\">\n                                <img alt=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-6-2-1-4-1-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/N0ZUMWk6omY/hqdefault.jpg\"/>\n                            </span>\n                            <span class=\"flex min-w-0 flex-1 flex-col justify-center px-3\" data-kid=\"1-1-2-6-2-1-4-2\" data-name=\"video info wrapper\">\n                                <strong class=\"line-clamp-2 text-[12px] font-black leading-[.96] tracking-[-.04em]\" data-kid=\"1-1-2-6-2-1-4-2-1\" data-name=\"video title text\">\n                                    BTS WORLD TOUR 'ARIRANG'\n                                </strong>\n                                <small class=\"mt-2 truncate text-[8px] font-bold text-white/50\" data-kid=\"1-1-2-6-2-1-4-2-2\" data-name=\"video source label\">\n                                    YouTube video\n                                </small>\n                            </span>\n                            <span class=\"liner-corner\" data-kid=\"1-1-2-6-2-1-4-3\" data-name=\"corner active marker\">\n                            </span>\n                        </button>\n                        <button aria-selected=\"false\" class=\"liner-entry flex h-[76px] min-w-[188px] snap-start text-left text-white/85 transition-colors duration-150 hover:bg-[#121212]\" data-kid=\"1-1-2-6-2-1-5\" data-name=\"inactive video button\" dir=\"ltr\" type=\"button\">\n                            <span class=\"liner-thumb relative block h-full w-12 shrink-0 overflow-hidden opacity-55\" data-kid=\"1-1-2-6-2-1-5-1\" data-name=\"video thumbnail container\">\n                                <img alt=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-6-2-1-5-1-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/xVP40kztb