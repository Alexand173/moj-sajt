      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap');\n\n  body {\n    margin: 0;\n    background: #fbfcfe;\n    color: #08090a;\n    font-family: 'Inter', Arial, Helvetica, sans-serif;\n  }\n\n  .source-monitor-page {\n    min-height: 720px;\n    background: #fbfcfe;\n    padding: 46px 40px 58px;\n  }\n\n  .source-monitor-container {\n    width: min(100%, 1120px);\n    margin: 0 auto;\n  }\n\n  .source-monitor-meta-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 18px;\n    margin-bottom: 20px;\n  }\n\n  .source-monitor-kicker,\n  .source-monitor-desk {\n    display: inline-flex;\n    align-items: center;\n    gap: 11px;\n    color: #e63946;\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: .28em;\n    line-height: 1;\n    text-transform: uppercase;\n  }\n\n  .source-monitor-kicker::before {\n    width: 40px;\n    height: 1px;\n    background: currentColor;\n    content: '';\n  }\n\n  .source-monitor-desk {\n    color: #64748b;\n    font-size: 9px;\n    letter-spacing: .2em;\n  }\n\n  .source-monitor-desk-dot {\n    position: relative;\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: #e63946;\n    box-shadow: 0 0 0 4px rgb(230 57 70 / 14%);\n  }\n\n  .source-monitor-player {\n    position: relative;\n    min-height: 406px;\n    overflow: hidden;\n    background: #08090a;\n    border-radius: 3px;\n    box-shadow: 0 16px 40px rgb(8 9 10 / 16%);\n    color: #fff;\n  }\n\n  .source-monitor-backdrop {\n    position: absolute;\n    inset: 0;\n    background-image: linear-gradient(90deg, rgb(0 0 0 / 91%), rgb(0 0 0 / 30%) 58%, rgb(0 0 0 / 48%)), linear-gradient(0deg, rgb(0 0 0 / 94%), transparent 64%), url('https://i.ytimg.com/vi/6f5SsjjrSp0/hqdefault.jpg');\n    background-position: center;\n    background-size: cover;\n    filter: saturate(.82) contrast(1.06);\n    opacity: .92;\n  }\n\n  .source-monitor-stage-lines {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(115deg, transparent 0 58%, rgb(230 57 70 / 8%) 58.1%, transparent 58.35%), linear-gradient(90deg, transparent 0 76%, rgb(255 255 255 / 5%) 76.2%, transparent 76.4%);\n    pointer-events: none;\n  }\n\n  .source-monitor-topline {\n    position: absolute;\n    inset: 22px 28px auto;\n    z-index: 2;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    color: rgb(255 255 255 / 72%);\n    font-size: 9px;\n    font-weight: 800;\n    letter-spacing: .17em;\n    text-transform: uppercase;\n  }\n\n  .source-monitor-live {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    color: #fff;\n  }\n\n  .source-monitor-live span {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: #e63946;\n    box-shadow: 0 0 0 4px rgb(230 57 70 / 15%);\n  }\n\n  .source-monitor-now-playing {\n    position: absolute;\n    left: 28px;\n    right: 28px;\n    bottom: 145px;\n    z-index: 2;\n    max-width: 530px;\n  }\n\n  .source-monitor-now-playing-label {\n    color: #e63946;\n    font-size: 9px;\n    font-weight: 900;\n    letter-spacing: .25em;\n    text-transform: uppercase;\n  }\n\n  .source-monitor-now-playing h1 {\n    max-width: 600px;\n    margin: 8px 0 0;\n    color: #fff;\n    font-size: clamp(30px, 4vw, 54px);\n    font-weight: 900;\n    letter-spacing: -.07em;\n    line-height: .92;\n  }\n\n  .source-monitor-now-playing p {\n    margin: 8px 0 0;\n    color: rgb(255 255 255 / 72%);\n    font-size: 12px;\n  }\n\n  .source-monitor-now-playing .venue {\n    margin-top: 7px;\n    color: rgb(255 255 255 / 48%);\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n  }\n\n  .source-monitor-play {\n    position: absolute;\n    top: 43%;\n    left: 50%;\n    z-index: 2;\n    display: grid;\n    width: 58px;\n    height: 58px;\n    place-items: center;\n    border: 0;\n    border-radius: 50%;\n    background: #e63946;\n    color: #fff;\n    cursor: pointer;\n    font-size: 21px;\n    transform: translate(-50%, -50%);\n    box-shadow: 0 10px 26px rgb(230 57 70 / 25%);\n  }\n\n  .source-monitor-play:hover { background: #fff; color: #08090a; }\n\n  .source-monitor-rail-label {\n    position: absolute;\n    bottom: 126px;\n    left: 28px;\n    z-index: 3;\n    color: rgb(255 255 255 / 52%);\n    font-size: 8px;\n    font-weight: 800;\n    letter-spacing: .22em;\n    text-transform: uppercase;\n  }\n\n  .source-monitor-viewport {\n    position: absolute;\n    right: 28px;\n    bottom: 28px;\n    left: 28px;\n    z-index: 3;\n    overflow: hidden;\n    isolation: isolate;\n  }\n\n  .source-monitor-viewport::before {\n    position: absolute;\n    top: 0;\n    bottom: 0;\n    left: -1px;\n    z-index: 5;\n    width: 62px;\n    background: linear-gradient(90deg, #08090a 9%, rgb(8 9 10 / 88%) 38%, transparent 100%);\n    content: '';\n    pointer-events: none;\n  }\n\n  .source-monitor-viewport::after {\n    position: absolute;\n    top: 50%;\n    left: 17px;\n    z-index: 6;\n    color: rgb(255 255 255 / 78%);\n    content: '‹';\n    font-size: 23px;\n    font-weight: 400;\n    line-height: 1;\n    pointer-events: none;\n    transform: translateY(-54%);\n  }\n\n  .source-monitor-rail {\n    display: flex;\n    gap: 8px;\n    min-width: max-content;\n    overflow-x: auto;\n    padding: 4px 0 5px;\n    scroll-behavior: smooth;\n    scroll-snap-type: x mandatory;\n    scrollbar-width: none;\n  }\n\n  .source-monitor-rail::-webkit-scrollbar { display: none; }\n\n  .source-monitor-card {\n    position: relative;\n    display: flex;\n    flex: 0 0 176px;\n    height: 68px;\n    overflow: hidden;\n    scroll-snap-align: start;\n    border: 1px solid rgb(255 255 255 / 22%);\n    background: #08090a;\n    color: #fff;\n    cursor: pointer;\n    text-align: left;\n    transition: border-color 180ms ease, background-color 180ms ease, transform 180ms ease;\n  }\n\n  .source-monitor-card:hover,\n  .source-monitor-card:focus-visible { border-color: rgb(255 255 255 / 68%); transform: translateY(-2px); }\n\n  .source-monitor-card:focus-visible { outline: 2px solid #e63946; outline-offset: 4px; }\n\n  .source-monitor-thumb {\n    position: relative;\n    flex: 0 0 62px;\n    overflow: hidden;\n    background: #1a1c20;\n  }\n\n  .source-monitor-thumb::after {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(90deg, transparent 55%, rgb(8 9 10 / 68%));\n    content: '';\n  }\n\n  .source-monitor-thumb img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    opacity: .62;\n    transition: opacity 180ms ease;\n  }\n\n  .source-monitor-card:hover .source-monitor-thumb img,\n  .source-monitor-card:focus-visible .source-monitor-thumb img { opacity: .82; }\n\n  .source-monitor-copy {\n    position: relative;\n    z-index: 1;\n    display: flex;\n    min-width: 0;\n    flex: 1;\n    flex-direction: column;\n    justify-content: flex-end;\n    gap: 4px;\n    padding: 8px 10px 8px 8px;\n  }\n\n  .source-monitor-artist {\n    display: -webkit-box;\n    overflow: hidden;\n    color: #fff;\n    font-size: 11px;\n    font-weight: 900;\n    letter-spacing: -.035em;\n    line-height: 1.04;\n    -webkit-box-orient: vertical;\n    -webkit-line-clamp: 2;\n  }\n\n  .source-monitor-source {\n    overflow: hidden;\n    color: rgb(255 255 255 / 62%);\n    font-size: 8px;\n    font-weight: 700;\n    letter-spacing: .06em;\n    line-height: 1;\n    text-overflow: ellipsis;\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  .source-monitor-dot {\n    position: absolute;\n    top: 8px;\n    left: 8px;\n    z-index: 2;\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: #e63946;\n    box-shadow: 0 0 0 4px rgb(230 57 70 / 17%);\n  }\n\n  .source-monitor-card .active-rule,\n  .source-monitor-card::before,\n  .source-monitor-card::after { display: none; }\n\n  .source-monitor-card.active { border-color: transparent; background: #08090a; }\n\n  .source-monitor-card.active::before,\n  .source-monitor-card.active::after {\n    position: absolute;\n    z-index: 4;\n    width: 12px;\n    height: 12px;\n    border-color: #e63946;\n    border-style: solid;\n    content: '';\n    display: block;\n  }\n\n  .source-monitor-card.active::before { top: -1px; left: -1px; border-width: 1px 0 0 1px; }\n  .source-monitor-card.active::after { right: -1px; bottom: -1px; border-width: 0 1px 1px 0; }\n  .source-monitor-card.active .active-rule { position: absolute; top: -1px; right: 12px; left: 12px; display: block; height: 1px; background: #e63946; }\n  .source-monitor-card.active .source-monitor-thumb img { opacity: .82; }\n  .source-monitor-card.active .source-monitor-dot { width: 8px; height: 8px; }\n\n  .source-monitor-footnote {\n    margin: 17px 0 0;\n    max-width: 560px;\n    color: #64748b;\n    font-size: 14px;\n    line-height: 1.55;\n  }\n\n  @media (max-width: 700px) {\n    .source-monitor-page { padding: 28px 16px 40px; }\n    .source-monitor-player { min-height: 430px; }\n    .source-monitor-topline { inset: 18px 18px auto; font-size: 8px; }\n    .source-monitor-now-playing { right: 18px; bottom: 156px; left: 18px; }\n    .source-monitor-now-playing h1 { font-size: 36px; }\n    .source-monitor-rail-label { bottom: 137px; left: 18px; }\n    .source-monitor-viewport { right: 18px; bottom: 25px; left: 18px; }\n    .source-monitor-card { flex-basis: 154px; height: 64px; }\n    .source-monitor-thumb { flex-basis: 58px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .source-monitor-rail { scroll-behavior: auto; }\n    .source-monitor-card,\n    .source-monitor-card:hover,\n    .source-monitor-card:focus-visible,\n    .source-monitor-thumb img { transition: none; transform: none; }\n  }\n</style>\n<div class=\"source-monitor-page\" data-kid=\"1\" data-name=\"page layout container\">\n    <section aria-label=\"On the road hero video source monitor\" class=\"source-monitor-container\" data-kid=\"1-1\" data-name=\"on the road video source monitor section\">\n        <div class=\"source-monitor-meta-row\" data-kid=\"1-1-1\" data-name=\"header metadata row\">\n            <p class=\"source-monitor-kicker\" data-kid=\"1-1-1-1\" data-name=\"kicker text\">\n                On the road · 2026\n            </p>\n            <p class=\"source-monitor-desk\" data-kid=\"1-1-1-2\" data-name=\"live desk status\">\n                <span aria-hidden=\"true\" class=\"source-monitor-desk-dot\" data-kid=\"1-1-1-2-1\" data-name=\"live status indicator dot\">\n                </span>\n                US live desk\n            </p>\n        </div>\n        <div class=\"source-monitor-player\" data-kid=\"1-1-2\" data-name=\"video player container\">\n            <div class=\"source-monitor-backdrop\" data-dynamic=\"true\" data-hero-backdrop=\"\" data-kid=\"1-1-2-1\" data-name=\"hero video backdrop\" data-reason=\"background image replaced by script on card click\">\n            </div>\n            <div aria-hidden=\"true\" class=\"source-monitor-stage-lines\" data-kid=\"1-1-2-2\" data-name=\"decorative stage lines\">\n            </div>\n            <div class=\"source-monitor-topline\" data-kid=\"1-1-2-3\" data-name=\"player topline area\">\n                <span class=\"source-monitor-live\" data-kid=\"1-1-2-3-1\" data-name=\"live status label\">\n                    <span aria-hidden=\"true\" data-kid=\"1-1-2-3-1-1\" data-name=\"live indicator dot\">\n                    </span>\n                    Live broadcast\n                </span>\n                <span data-kid=\"1-1-2-3-2\" data-name=\"broadcast channel info\">\n                    ⌁ MusicTop · Stage 1\n                </span>\n            </div>\n            <button aria-label=\"Play Metallica: Life Burns Faster video\" class=\"source-monitor-play\" data-dynamic=\"true\" data-kid=\"1-1-2-4\" data-name=\"play button\" data-reason=\"aria-label updated by script on card selection\" type=\"button\">\n                ▶\n            </button>\n            <div class=\"source-monitor-now-playing\" data-kid=\"1-1-2-5\" data-name=\"now playing info container\">\n                <div class=\"source-monitor-now-playing-label\" data-kid=\"1-1-2-5-1\" data-name=\"now playing label\">\n                    Now playing\n                </div>\n                <h1 data-dynamic=\"true\" data-hero-artist=\"\" data-kid=\"1-1-2-5-2\" data-name=\"artist name headline\" data-reason=\"text replaced by script on card click\">\n                    Metallica: Life Burns Faster\n                </h1>\n                <p data-hero-source=\"\" data-kid=\"1-1-2-5-3\" data-name=\"source description\">\n                    Official YouTube video\n                </p>\n                <p class=\"venue\" data-dynamic=\"true\" data-hero-venue=\"\" data-kid=\"1-1-2-5-4\" data-name=\"venue name\" data-reason=\"text replaced by script on card click\">\n                    SPHERE · LAS VEGAS\n                </p>\n            </div>\n            <div class=\"source-monitor-rail-label\" data-kid=\"1-1-2-6\" data-name=\"video source rail label\">\n                Video sources · 15 available\n            </div>\n            <div class=\"source-monitor-viewport\" data-kid=\"1-1-2-7\" data-name=\"rail scroll container\">\n                <div aria-label=\"Choose an on the road video\" class=\"source-monitor-rail\" data-kid=\"1-1-2-7-1\" data-name=\"video source selector list\" dir=\"rtl\" role=\"listbox\">\n                    <button aria-label=\"Show Metallica: Life Burns Faster live preview\" aria-selected=\"true\" class=\"source-monitor-card active\" data-artist=\"Metallica: Life Burns Faster\" data-dynamic=\"true\" data-kid=\"1-1-2-7-1-1\" data-name=\"metallica video card\" data-reason=\"aria-selected updated by script\" data-venue=\"SPHERE · LAS VEGAS\" data-video=\"6f5SsjjrSp0\" role=\"option\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"active-rule\" data-kid=\"1-1-2-7-1-1-1\" data-name=\"card active status rule\">\n                        </span>\n                        <span class=\"source-monitor-thumb\" data-kid=\"1-1-2-7-1-1-2\" data-name=\"thumbnail container\">\n                            <img alt=\"\" data-kid=\"1-1-2-7-1-1-2-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/6f5SsjjrSp0/hqdefault.jpg\"/>\n                            <span aria-hidden=\"true\" class=\"source-monitor-dot\" data-kid=\"1-1-2-7-1-1-2-2\" data-name=\"card status indicator dot\">\n                            </span>\n                        </span>\n                        <span class=\"source-monitor-copy\" data-kid=\"1-1-2-7-1-1-3\" data-name=\"card info container\">\n                            <span class=\"source-monitor-artist\" data-kid=\"1-1-2-7-1-1-3-1\" data-name=\"artist name text\">\n                                Metallica: Life Burns Faster\n                            </span>\n                            <span class=\"source-monitor-source\" data-kid=\"1-1-2-7-1-1-3-2\" data-name=\"source platform text\">\n                                YouTube video\n                            </span>\n                        </span>\n                    </button>\n                    <button aria-label=\"Show Bruno Mars - The Romantic Tour live preview\" aria-selected=\"false\" class=\"source-monitor-card\" data-artist=\"Bruno Mars - The Romantic Tour\" data-dynamic=\"true\" data-kid=\"1-1-2-7-1-2\" data-name=\"bruno mars video card\" data-reason=\"aria-selected updated by script\" data-venue=\"WEMBLEY STADIUM · LONDON\" data-video=\"yQK34fHQLJ0\" role=\"option\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"active-rule\" data-kid=\"1-1-2-7-1-2-1\" data-name=\"card active status rule\">\n                        </span>\n                        <span class=\"source-monitor-thumb\" data-kid=\"1-1-2-7-1-2-2\" data-name=\"thumbnail container\">\n                            <img alt=\"\" data-kid=\"1-1-2-7-1-2-2-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/yQK34fHQLJ0/hqdefault.jpg\"/>\n                            <span aria-hidden=\"true\" class=\"source-monitor-dot\" data-kid=\"1-1-2-7-1-2-2-2\" data-name=\"card status indicator dot\">\n                            </span>\n                        </span>\n                        <span class=\"source-monitor-copy\" data-kid=\"1-1-2-7-1-2-3\" data-name=\"card info container\">\n                            <span class=\"source-monitor-artist\" data-kid=\"1-1-2-7-1-2-3-1\" data-name=\"artist name text\">\n                                Bruno Mars - The Romantic Tour\n                            </span>\n                            <span class=\"source-monitor-source\" data-kid=\"1-1-2-7-1-2-3-2\" data-name=\"source platform text\">\n                                YouTube video\n                            </span>\n                        </span>\n                    </button>\n                    <button aria-label=\"Show Harry Styles: Together, Together live preview\" aria-selected=\"false\" class=\"source-monitor-card\" data-artist=\"Harry Styles: Together, Together\" data-dynamic=\"true\" data-kid=\"1-1-2-7-1-3\" data-name=\"harry styles video card\" data-reason=\"aria-selected updated by script\" data-venue=\"WEMBLEY STADIUM · LONDON\" data-video=\"w54r_M6D0Lk\" role=\"option\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"active-rule\" data-kid=\"1-1-2-7-1-3-1\" data-name=\"card active status rule\">\n                        </span>\n                        <span class=\"source-monitor-thumb\" data-kid=\"1-1-2-7-1-3-2\" data-name=\"thumbnail container\">\n                            <img alt=\"\" data-kid=\"1-1-2-7-1-3-2-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/w54r_M6D0Lk/hqdefault.jpg\"/>\n                            <span aria-hidden=\"true\" class=\"source-monitor-dot\" data-kid=\"1-1-2-7-1-3-2-2\" data-name=\"card status indicator dot\">\n                            </span>\n                        </span>\n                        <span class=\"source-monitor-copy\" data-kid=\"1-1-2-7-1-3-3\" data-name=\"card info container\">\n                            <span class=\"source-monitor-artist\" data-kid=\"1-1-2-7-1-3-3-1\" data-name=\"artist name text\">\n                                Harry Styles: Together, Together\n                            </span>\n                            <span class=\"source-monitor-source\" data-kid=\"1-1-2-7-1-3-3-2\" data-name=\"source platform text\">\n                                YouTube video\n                            </span>\n                        </span>\n                    </button>\n                    <button aria-label=\"Show BTS WORLD TOUR ARIRANG IN LOS ANGELES live preview\" aria-selected=\"false\" class=\"source-monitor-card\" data-artist=\"BTS WORLD TOUR 'ARIRANG' IN LOS ANGELES\" data-dynamic=\"true\" data-kid=\"1-1-2-7-1-4\" data-name=\"bts video card\" data-reason=\"aria-selected updated by script\" data-venue=\"SOFI STADIUM · LOS ANGELES\" data-video=\"N0ZUMWk6omY\" role=\"option\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"active-rule\" data-kid=\"1-1-2-7-1-4-1\" data-name=\"card active status rule\">\n                        </span>\n                        <span class=\"source-monitor-thumb\" data-kid=\"1-1-2-7-1-4-2\" data-name=\"thumbnail container\">\n                            <img alt=\"\" data-kid=\"1-1-2-7-1-4-2-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/N0ZUMWk6omY/hqdefault.jpg\"/>\n                            <span aria-hidden=\"true\" class=\"source-monitor-dot\" data-kid=\"1-1-2-7-1-4-2-2\" data-name=\"card status indicator dot\">\n                            </span>\n                        </span>\n                        <span class=\"source-monitor-copy\" data-kid=\"1-1-2-7-1-4-3\" data-name=\"card info container\">\n                            <span class=\"source-monitor-artist\" data-kid=\"1-1-2-7-1-4-3-1\" data-name=\"artist name text\">\n                                BTS WORLD TOUR 'ARIRANG' IN LOS ANGELES\n                            </span>\n                            <span class=\"source-monitor-source\" data-kid=\"1-1-2-7-1-4-3-2\" data-name=\"source platform text\">\n                                YouTube video\n                            </span>\n                        </span>\n                    </button>\n                    <button aria-label=\"Show Zach Bryan live preview\" aria-selected=\"false\" class=\"source-monitor-card\" data-artist=\"Zach Bryan\" data-dynamic=\"true\" data-kid=\"1-1-2-7-1-5\" data-name=\"zach bryan video card\" data-reason=\"aria-selected updated by script\" data-venue=\"PROTECTIVE STADIUM · BIRMINGHAM\" data-video=\"xVP40kztbts\" role=\"option\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"active-rule\" data-kid=\"1-1-2-7-1-5-1\" data-name=\"card active status rule\">\n                        </span>\n                        <span class=\"source-monitor-thumb\" data-kid=\"1-1-2-7-1-5-2\" data-name=\"thumbnail container\">\n                            <img alt=\"\" data-kid=\"1-1-2-7-1-5-2-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/xVP40kztbts/hqdefault.jpg\"/>\n                            <span aria-hidden=\"true\" class=\"source-monitor-dot\" data-kid=\"1-1-2-7-1-5-2-2\" data-name=\"card status indicator dot\">\n                            </span>\n                        </span>\n                        <span class=\"source-monitor-copy\" data-kid=\"1-1-2-7-1-5-3\" data-name=\"card info container\">\n                            <span class=\"source-monitor-artist\" data-kid=\"1-1-2-7-1-5-3-1\" data-name=\"artist name text\">\n                                Zach Bryan\n                            </span>\n                            <span class=\"source-monitor-source\" data-kid=\"1-1-2-7-1-5-3-2\" data-name=\"source platform text\">\n                                YouTube video\n                            </span>\n                        </span>\n                    </button>\n                    <button aria-label=\"Show Backstreet Boys Into The Millennium live preview\" aria-selected=\"false\" class=\"source-monitor-card\" data-artist=\"Backstreet Boys: Into The Millennium\" data-dynamic=\"true\" data-kid=\"1-1-2-7-1-6\" data-name=\"backstreet boys video card\" data-reason=\"aria-selected updated by script\" data-venue=\"TOUR ARCHIVE · US\" data-video=\"nqdMxE0fFDc\" role=\"option\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"active-rule\" data-kid=\"1-1-2-7-1-6-1\" data-name=\"card active status rule\">\n                        </span>\n                        <span class=\"source-monitor-thumb\" data-kid=\"1-1-2-7-1-6-2\" data-name=\"thumbnail container\">\n                            <img alt=\"\" data-kid=\"1-1-2-7-1-6-2-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/nqdMxE0fFDc/hqdefault.jpg\"/>\n                            <span aria-hidden=\"true\" class=\"source-monitor-dot\" data-kid=\"1-1-2-7-1-6-2-2\" data-name=\"card status indicator dot\">\n                            </span>\n                        </span>\n                        <span class=\"source-monitor-copy\" data-kid=\"1-1-2-7-1-6-3\" data-name=\"card info container\">\n                            <span class=\"source-monitor-artist\" data-kid=\"1-1-2-7-1-6-3-1\" data-name=\"artist name text\">\n                                Backstreet Boys: Into The Millennium\n                            </span>\n                            <span class=\"source-monitor-source\" data-kid=\"1-1-2-7-1-6-3-2\" data-name=\"source platform text\">\n                                YouTube video\n                            </span>\n                        </span>\n                    </button>\n                    <button aria-label=\"Show Ed Sheeran LOOP Tour live preview\" aria-selected=\"false\" class=\"source-monitor-card\" data-artist=\"Ed Sheeran: LOOP Tour\" data-dynamic=\"true\" data-kid=\"1-1-2-7-1-7\" data-name=\"ed sheeran video card\" data-reason=\"aria-selected updated by script\" data-venue=\"WEMBLEY STADIUM · LONDON\" data-video=\"iWuPORCVclA\" role=\"option\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"active-rule\" data-kid=\"1-1-2-7-1-7-1\" data-name=\"card active status rule\">\n                        </span>\n                        <span class=\"source-monitor-thumb\" data-kid=\"1-1-2-7-1-7-2\" data-name=\"thumbnail container\">\n                            <img alt=\"\" data-kid=\"1-1-2-7-1-7-2-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/iWuPORCVclA/hqdefault.jpg\"/>\n                            <span aria-hidden=\"true\" class=\"source-monitor-dot\" data-kid=\"1-1-2-7-1-7-2-2\" data-name=\"card status indicator dot\">\n                            </span>\n                        </span>\n                        <span class=\"source-monitor-copy\" data-kid=\"1-1-2-7-1-7-3\" data-name=\"card info container\">\n                            <span class=\"source-monitor-artist\" data-kid=\"1-1-2-7-1-7-3-1\" data-name=\"artist name text\">\n                                Ed Sheeran: LOOP Tour\n                            </span>\n                            <span class=\"source-monitor-source\" data-kid=\"1-1-2-7-1-7-3-2\" data-name=\"source platform text\">\n                                YouTube video\n                            </span>\n                        </span>\n                    </button>\n                    <button aria-label=\"Show Luke Bryan and Jason Aldean Double Down Tour live preview\" aria-selected=\"false\" class=\"source-monitor-card\" data-artist=\"Luke Bryan & Jason Aldean: Double Down Tour 2026\" data-dynamic=\"true\" data-kid=\"1-1-2-7-1-8\" data-name=\"luke bryan video card\" data-reason=\"aria-selected updated by script\" data-venue=\"NASHVILLE · LIVE DESK\" data-video=\"r1AYY5hUPb4\" role=\"option\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"active-rule\" data-kid=\"1-1-2-7-1-8-1\" data-name=\"card active status rule\">\n                        </span>\n                        <span class=\"source-monitor-thumb\" data-kid=\"1-1-2-7-1-8-2\" data-name=\"thumbnail container\">\n                            <img alt=\"\" data-kid=\"1-1-2-7-1-8-2-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/r1AYY5hUPb4/hqdefault.jpg\"/>\n                            <span aria-hidden=\"true\" class=\"source-monitor-dot\" data-kid=\"1-1-2-7-1-8-2-2\" data-name=\"card status indicator dot\">\n                            </span>\n                        </span>\n                        <span class=\"source-monitor-copy\" data-kid=\"1-1-2-7-1-8-3\" data-name=\"card info container\">\n                            <span class=\"source-monitor-artist\" data-kid=\"1-1-2-7-1-8-3-1\" data-name=\"artist name text\">\n                                Luke Bryan & Jason Aldean: Double Down Tour 2026\n                            </span>\n                            <span class=\"source-monitor-source\" data-kid=\"1-1-2-7-1-8-3-2\" data-name=\"source platform text\">\n                                YouTube video\n                            </span>\n                        </span>\n                    </button>\n                </div>\n            </div>\n        </div>\n        <p class=\"source-monitor-footnote\" data-kid=\"1-1-3\" data-name=\"footnote text\">\n            Explore current live event schedules, verified ticket links and availability across the US. Buy official concert tickets for 2026 tours — every date is cross-checked against the promoter's schedule.\n        </p>\n    </section>\n</div>\n<script>\n    (() => {\n    const railCards = Array.from(document.querySelectorAll('.source-monitor-card'));\n    const artist = document.querySelector('[data-hero-artist]');\n    const venue = document.querySelector('[data-hero-venue]');\n    const backdrop = document.querySelector('[data-hero-backdrop]');\n    const play = document.querySelector('.source-monitor-play');\n\n    railCards.forEach((card) => {\n      card.addEventListener('click', () => {\n        railCards.forEach((item) => {\n          const isActive = item === card;\n          item.classList.toggle('active', isActive);\n          item.setAttribute('aria-selected', String(isActive));\n        });\n        artist.textContent = card.dataset.artist || '';\n        venue.textContent = card.dataset.venue || '';\n        play.setAttribute('aria-label', `Play ${card.dataset.artist || 'selected'} video`);\n        backdrop.style.backgroundImage = `linear-gradient(90deg, rgb(0 0 0 / 91%), rgb(0 0 0 / 30%) 58%, rgb(0 0 0 / 48%)), linear-gradient(0deg, rgb(0 0 0 / 94%), transparent 64%), url('https://i.ytimg.com/vi/${card.dataset.video}/hqdefault.jpg')`;\n      });\n    });\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-09-12T16:31:31.973418+00:00",
      "modified": "2026-09-12T16:32:15.024650+00:00",
