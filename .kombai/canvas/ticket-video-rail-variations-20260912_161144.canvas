mg alt=\"\" class=\"h-full w-full object-cover opacity-65\" data-kid=\"1-1-2-6-1-1-8-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/r1AYY5hUPb4/hqdefault.jpg\"/>\n                                <span class=\"absolute inset-y-0 right-[-1px] border-r border-dashed border-[#64748b]\" data-kid=\"1-1-2-6-1-1-8-1-2\">\n                                </span>\n                                <span class=\"absolute -right-2 -top-2 h-4 w-4 rounded-full bg-[#08090a]\" data-kid=\"1-1-2-6-1-1-8-1-3\">\n                                </span>\n                                <span class=\"absolute -right-2 -bottom-2 h-4 w-4 rounded-full bg-[#08090a]\" data-kid=\"1-1-2-6-1-1-8-1-4\">\n                                </span>\n                            </span>\n                            <span class=\"flex min-w-0 flex-1 flex-col justify-end px-3 pb-2\" data-kid=\"1-1-2-6-1-1-8-2\">\n                                <span class=\"line-clamp-2 text-[11px] font-black leading-[1.02] tracking-[-0.04em]\" data-kid=\"1-1-2-6-1-1-8-2-1\">\n                                    Luke Bryan & Jason Aldean: Double Down Tour 2026\n                                </span>\n                                <span class=\"mt-1 truncate text-[8px] font-bold uppercase tracking-[0.08em] text-white/55\" data-kid=\"1-1-2-6-1-1-8-2-2\">\n                                    YouTube video\n                                </span>\n                            </span>\n                        </button>\n                    </div>\n                    <div class=\"pointer-events-none absolute inset-y-0 left-0 z-30 w-32 bg-gradient-to-r from-[#08090a] via-[#08090a]/90 to-transparent\" data-kid=\"1-1-2-6-1-2\">\n                    </div>\n                    <div class=\"pointer-events-none absolute left-5 top-1/2 z-40 -translate-y-1/2 text-2xl font-light text-white/75\" data-kid=\"1-1-2-6-1-3\">\n                        ‹\n                    </div>\n                </div>\n            </div>\n        </section>\n        <p class=\"mt-6 max-w-[620px] text-[15px] leading-relaxed text-[#64748b]\" data-kid=\"1-1-3\">\n            Explore current live event schedules, verified ticket links and availability across the US. Buy official concert tickets for 2026 tours — every date is cross-checked against the promoter's schedule.\n        </p>\n    </div>\n</div>\n",
