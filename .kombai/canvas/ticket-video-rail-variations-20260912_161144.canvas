    "var_5a10f4005c17": {
      "type": "variant",
      "label": "On the Road Rail — Ticket Strip",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4140,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.34.0/dist/tabler-icons.min.css');\n\n  .ticket-preview-shell {\n    min-height: 800px;\n    background: #fbfcfe;\n    color: #08090a;\n    font-family: Inter, Arial, Helvetica, sans-serif;\n  }\n\n  .ticket-preview-inner {\n    width: min(100% - 10rem, 1120px);\n    margin-inline: auto;\n    padding: 62px 0 72px;\n  }\n\n  .ticket-preview-head {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 20px;\n    margin-bottom: 22px;\n  }\n\n  .ticket-preview-kicker {\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n    color: #e63946;\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: .3em;\n    line-height: 1.2;\n    text-transform: uppercase;\n  }\n\n  .ticket-preview-kicker::before {\n    width: 40px;\n    height: 1px;\n    background: currentColor;\n    content: '';\n  }\n\n  .ticket-preview-live {\n    display: inline-flex;\n    align-items: center;\n    gap: 9px;\n    color: #64748b;\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: .2em;\n    text-transform: uppercase;\n  }\n\n  .ticket-preview-live-dot {\n    width: 7px;\n    height: 7px;\n    border: 1px solid #e63946;\n    border-radius: 999px;\n    background: #e63946;\n    box-shadow: 0 0 0 4px rgb(230 57 70 / 14%);\n  }\n\n  .ticket-player {\n    position: relative;\n    height: 480px;\n    overflow: hidden;\n    background: #08090a;\n    box-shadow: 0 16px 40px rgb(8 9 10 / 16%);\n  }\n\n  .ticket-player-backdrop {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    opacity: .5;\n    filter: saturate(.8) contrast(1.1);\n  }\n\n  .ticket-player::after {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(90deg, rgb(0 0 0 / 88%), rgb(0 0 0 / 20%) 62%, rgb(0 0 0 / 36%)), linear-gradient(0deg, rgb(0 0 0 / 94%), transparent 62%);\n    content: '';\n    pointer-events: none;\n  }\n\n  .ticket-player-meta {\n    position: absolute;\n    inset: 22px 24px auto;\n    z-index: 2;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    color: rgb(255 255 255 / 72%);\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n\n  .ticket-player-meta strong {\n    display: inline-flex;\n    align-items: center;\n    gap: 9px;\n    color: #fff;\n  }\n\n  .ticket-player-meta strong::before {\n    width: 7px;\n    height: 7px;\n    border-radius: 999px;\n    background: #e63946;\n    box-shadow: 0 0 0 4px rgb(230 57 70 / 16%);\n    content: '';\n  }\n\n  .ticket-player-copy {\n    position: absolute;\n    left: 24px;\n    bottom: 134px;\n    z-index: 2;\n    max-width: 510px;\n    color: #fff;\n  }\n\n  .ticket-player-eyebrow {\n    color: #e63946;\n    font-size: 10px;\n    font-weight: 900;\n    letter-spacing: .24em;\n    text-transform: uppercase;\n  }\n\n  .ticket-player-title {\n    margin: 6px 0 0;\n    max-width: 510px;\n    font-size: clamp(32px, 4vw, 52px);\n    font-weight: 900;\n    letter-spacing: -.065em;\n    line-height: .92;\n  }\n\n  .ticket-player-subtitle {\n    margin-top: 9px;\n    color: rgb(255 255 255 / 74%);\n    font-size: 12px;\n  }\n\n  .ticket-player-venue {\n    margin-top: 7px;\n    color: rgb(255 255 255 / 46%);\n    font-size: 9px;\n    font-weight: 800;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n  }\n\n  .ticket-play {\n    position: absolute;\n    top: 41%;\n    left: 50%;\n    z-index: 2;\n    display: grid;\n    width: 58px;\n    height: 58px;\n    place-items: center;\n    border: 0;\n    border-radius: 999px;\n    background: #fff;\n    color: #08090a;\n    cursor: pointer;\n    transform: translate(-50%, -50%);\n  }\n\n  .ticket-play::after {\n    width: 0;\n    height: 0;\n    margin-left: 4px;\n    border-top: 8px solid transparent;\n    border-bottom: 8px solid transparent;\n    border-left: 11px solid currentColor;\n    content: '';\n  }\n\n  .ticket-play:hover { transform: translate(-50%, -50%) scale(1.04); }\n\n  .ticket-rail-region {\n    position: absolute;\n    right: 24px;\n    bottom: 20px;\n    left: 24px;\n    z-index: 3;\n  }\n\n  .ticket-rail-label {\n    margin-bottom: 8px;\n    color: rgb(255 255 255 / 48%);\n    font-family: 'SFMono-Regular', Consolas, monospace;\n    font-size: 8px;\n    font-weight: 700;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n  }\n\n  .ticket-rail-viewport {\n    position: relative;\n    overflow: hidden;\n    padding: 0 0 3px;\n  }\n\n  .ticket-rail {\n    display: flex;\n    flex-direction: row;\n    gap: 8px;\n    overflow-x: auto;\n    padding: 0 10px 2px 26px;\n    direction: rtl;\n    scroll-behavior: smooth;\n    scroll-snap-type: x mandatory;\n    scrollbar-width: none;\n  }\n\n  .ticket-rail::-webkit-scrollbar { display: none; }\n\n  .ticket-card {\n    position: relative;\n    display: grid;\n    flex: 0 0 148px;\n    grid-template-columns: 46px minmax(0, 1fr);\n    height: 76px;\n    overflow: visible;\n    border: 1px solid rgb(148 163 184 / 56%);\n    border-bottom: 1px solid rgb(203 213 225 / 54%);\n    background: #121212;\n    color: #fff;\n    cursor: pointer;\n    scroll-snap-align: start;\n    text-align: left;\n    transition: background-color 120ms ease, border-color 120ms ease;\n  }\n\n  .ticket-card:hover { border-color: #cbd5e1; }\n\n  .ticket-card:focus-visible {\n    outline: 2px solid #e63946;\n    outline-offset: 4px;\n  }\n\n  .ticket-card::before,\n  .ticket-card::after {\n    position: absolute;\n    left: 41px;\n    z-index: 4;\n    width: 10px;\n    height: 10px;\n    border-radius: 999px;\n    background: #08090a;\n    content: '';\n    transform: translateX(-50%);\n  }\n\n  .ticket-card::before { top: -6px; }\n  .ticket-card::after { bottom: -6px; }\n\n  .ticket-card-stub {\n    position: relative;\n    overflow: hidden;\n    background: #1a1c20;\n  }\n\n  .ticket-card-stub::after {\n    position: absolute;\n    inset: 0;\n    background: rgb(0 0 0 / 42%);\n    content: '';\n  }\n\n  .ticket-card-stub img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    opacity: .85;\n  }\n\n  .ticket-card-seam {\n    position: absolute;\n    top: 7px;\n    bottom: 7px;\n    left: 46px;\n    z-index: 3;\n    border-left: 1px dashed #64748b;\n  }\n\n  .ticket-card-copy {\n    display: flex;\n    min-width: 0;\n    flex-direction: column;\n    justify-content: flex-end;\n    padding: 8px 8px 9px 10px;\n    background: #121212;\n  }\n\n  .ticket-card-artist {\n    display: -webkit-box;\n    overflow: hidden;\n    color: #fff;\n    font-size: 10px;\n    font-weight: 900;\n    letter-spacing: -.04em;\n    line-height: 1.04;\n    -webkit-box-orient: vertical;\n    -webkit-line-clamp: 2;\n  }\n\n  .ticket-card-source {\n    overflow: hidden;\n    margin-top: 5px;\n    color: rgb(255 255 255 / 58%);\n    font-size: 8px;\n    font-weight: 700;\n    letter-spacing: .02em;\n    line-height: 1;\n    text-overflow: ellipsis;\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  .ticket-card-live-dot {\n    position: absolute;\n    top: 8px;\n    left: 8px;\n    z-index: 5;\n    width: 6px;\n    height: 6px;\n    border-radius: 999px;\n    background: #e63946;\n    box-shadow: 0 0 0 3px rgb(230 57 70 / 20%);\n  }\n\n  .ticket-card-punch {\n    position: absolute;\n    top: 50%;\n    right: -4px;\n    z-index: 6;\n    width: 8px;\n    height: 8px;\n    border: 1px solid #e63946;\n    border-radius: 999px;\n    background: #e63946;\n    transform: translateY(-50%);\n  }\n\n  .ticket-card.is-active {\n    border-color: #e63946;\n    border-right-color: #e63946;\n    border-bottom: 2px solid #e63946;\n    background: #fbfcfe;\n  }\n\n  .ticket-card.is-active .ticket-card-copy {\n    background: #fbfcfe;\n    color: #08090a;\n  }\n\n  .ticket-card.is-active .ticket-card-artist { color: #08090a; }\n  .ticket-card.is-active .ticket-card-source { color: #64748b; }\n  .ticket-card.is-active .ticket-card-seam { border-color: #e63946; }\n\n  .ticket-rail-fade {\n    position: absolute;\n    top: -5px;\n    bottom: 0;\n    left: 0;\n    z-index: 8;\n    display: flex;\n    width: 58px;\n    align-items: center;\n    justify-content: flex-start;\n    padding-left: 7px;\n    background: linear-gradient(90deg, #08090a 2%, rgb(8 9 10 / 94%) 28%, transparent 100%);\n    color: rgb(255 255 255 / 72%);\n    pointer-events: none;\n  }\n\n  .ticket-rail-fade i { font-size: 18px; }\n\n  .ticket-preview-description {\n    max-width: 610px;\n    margin-top: 22px;\n    color: #64748b;\n    font-size: 16px;\n    line-height: 1.65;\n  }\n\n  @media (max-width: 700px) {\n    .ticket-preview-inner { width: min(100% - 3rem, 1120px); padding-top: 36px; }\n    .ticket-preview-head { margin-bottom: 16px; }\n    .ticket-player { height: 470px; }\n    .ticket-player-meta { inset: 16px; font-size: 8px; }\n    .ticket-player-copy { right: 16px; bottom: 126px; left: 16px; }\n    .ticket-player-title { font-size: 32px; }\n    .ticket-rail-region { right: 16px; bottom: 16px; left: 16px; }\n    .ticket-rail { padding-left: 20px; }\n    .ticket-card { flex-basis: 132px; height: 70px; grid-template-columns: 42px minmax(0, 1fr); }\n    .ticket-card-seam { left: 42px; }\n    .ticket-card::before, .ticket-card::after { left: 37px; }\n    .ticket-card-artist { font-size: 10px; }\n    .ticket-preview-description { font-size: 14px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .ticket-rail { scroll-behavior: auto; }\n    .ticket-card, .ticket-play { transition: none; }\n  }\n</style>\n<div class=\"ticket-preview-shell\" data-kid=\"1\" data-name=\"ticket preview shell\">\n    <main class=\"ticket-preview-inner\" data-kid=\"1-1\" data-name=\"ticket preview main container\">\n        <header class=\"ticket-preview-head\" data-kid=\"1-1-1\" data-name=\"ticket preview header\">\n            <p class=\"ticket-preview-kicker\" data-kid=\"1-1-1-1\" data-name=\"on the road kicker text\">\n                On the road · 2026\n            </p>\n            <p class=\"ticket-preview-live\" data-kid=\"1-1-1-2\" data-name=\"live status indicator container\">\n                <span aria-hidden=\"true\" class=\"ticket-preview-live-dot\" data-kid=\"1-1-1-2-1\" data-name=\"live dot icon\">\n                </span>\n                US live desk\n            </p>\n        </header>\n        <section aria-label=\"On the road concert video preview\" class=\"ticket-player\" data-kid=\"1-1-2\" data-name=\"concert video player container\">\n            <img alt=\"\" class=\"ticket-player-backdrop\" data-kid=\"1-1-2-1\" data-name=\"player backdrop image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/6f5SsjjrSp0/hqdefault.jpg\"/>\n            <div class=\"ticket-player-meta\" data-kid=\"1-1-2-2\" data-name=\"player metadata container\">\n                <strong data-kid=\"1-1-2-2-1\" data-name=\"live broadcast label\">\n                    Live broadcast\n                </strong>\n                <span data-kid=\"1-1-2-2-2\" data-name=\"broadcast source info\">\n                    ⌁ MusicTop · Stage 1\n                </span>\n            </div>\n            <button aria-label=\"Play Metallica live preview\" class=\"ticket-play\" data-dynamic=\"true\" data-kid=\"1-1-2-3\" data-name=\"play video button\" data-reason=\"aria-label updated when video card is selected\" type=\"button\">\n            </button>\n            <div class=\"ticket-player-copy\" data-kid=\"1-1-2-4\" data-name=\"player content overlay\">\n                <p class=\"ticket-player-eyebrow\" data-kid=\"1-1-2-4-1\" data-name=\"now playing eyebrow text\">\n                    Now playing\n                </p>\n                <h1 class=\"ticket-player-title\" data-dynamic=\"true\" data-kid=\"1-1-2-4-2\" data-name=\"player title headline\" data-player-title=\"\" data-reason=\"text replaced when video card is selected\">\n                    Metallica: Life Burns Faster\n                </h1>\n                <p class=\"ticket-player-subtitle\" data-kid=\"1-1-2-4-3\" data-name=\"player source text\" data-player-source=\"\">\n                    Official YouTube video\n                </p>\n                <p class=\"ticket-player-venue\" data-dynamic=\"true\" data-kid=\"1-1-2-4-4\" data-name=\"player venue text\" data-player-venue=\"\" data-reason=\"text replaced when video card is selected\">\n                    Sphere · Las Vegas\n                </p>\n            </div>\n            <div class=\"ticket-rail-region\" data-kid=\"1-1-2-5\" data-name=\"video rail region\">\n                <div class=\"ticket-rail-label\" data-kid=\"1-1-2-5-1\" data-name=\"rail label\">\n                    Official source rail\n                </div>\n                <div class=\"ticket-rail-viewport\" data-kid=\"1-1-2-5-2\" data-name=\"rail viewport\">\n                    <div aria-label=\"Choose a video\" class=\"ticket-rail\" data-kid=\"1-1-2-5-2-1\" data-name=\"video listbox\" dir=\"rtl\" role=\"listbox\">\n                        <button aria-label=\"Show Metallica live preview\" aria-selected=\"true\" class=\"ticket-card is-active\" data-dynamic=\"true\" data-kid=\"1-1-2-5-2-1-1\" data-name=\"video card\" data-reason=\"aria-selected and classList updated by script on interaction\" data-title=\"Metallica: Life Burns Faster\" data-venue=\"Sphere · Las Vegas\" data-video=\"6f5SsjjrSp0\" role=\"option\" type=\"button\">\n                            <span class=\"ticket-card-stub\" data-kid=\"1-1-2-5-2-1-1-1\" data-name=\"video card thumbnail container\">\n                                <img alt=\"\" data-kid=\"1-1-2-5-2-1-1-1-1\" data-name=\"video card thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/6f5SsjjrSp0/hqdefault.jpg\"/>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"ticket-card-seam\" data-kid=\"1-1-2-5-2-1-1-2\" data-name=\"video card separator seam\">\n                            </span>\n                            <span class=\"ticket-card-copy\" data-kid=\"1-1-2-5-2-1-1-3\" data-name=\"video card text container\">\n                                <span class=\"ticket-card-artist\" data-kid=\"1-1-2-5-2-1-1-3-1\" data-name=\"video card artist name\">\n                                    Metallica\n                                </span>\n                                <span class=\"ticket-card-source\" data-kid=\"1-1-2-5-2-1-1-3-2\" data-name=\"video card source name\">\n                                    YouTube video\n                                </span>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"ticket-card-live-dot\" data-kid=\"1-1-2-5-2-1-1-4\" data-name=\"video card live dot\">\n                            </span>\n                            <span aria-hidden=\"true\" class=\"ticket-card-punch\" data-kid=\"1-1-2-5-2-1-1-5\" data-name=\"video card punch icon\">\n                            </span>\n                        </button>\n                        <button aria-label=\"Show Bruno Mars live preview\" aria-selected=\"false\" class=\"ticket-card\" data-dynamic=\"true\" data-kid=\"1-1-2-5-2-1-2\" data-name=\"video card\" data-reason=\"aria-selected and classList updated by script on interaction\" data-title=\"Bruno Mars — The Romantic Tour\" data-venue=\"Las Vegas · 2026\" data-video=\"yQK34fHQLJ0\" role=\"option\" type=\"button\">\n                            <span class=\"ticket-card-stub\" data-kid=\"1-1-2-5-2-1-2-1\" data-name=\"video card thumbnail container\">\n                                <img alt=\"\" data-kid=\"1-1-2-5-2-1-2-1-1\" data-name=\"video card thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/yQK34fHQLJ0/hqdefault.jpg\"/>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"ticket-card-seam\" data-kid=\"1-1-2-5-2-1-2-2\" data-name=\"video card separator seam\">\n                            </span>\n                            <span class=\"ticket-card-copy\" data-kid=\"1-1-2-5-2-1-2-3\" data-name=\"video card text container\">\n                                <span class=\"ticket-card-artist\" data-kid=\"1-1-2-5-2-1-2-3-1\" data-name=\"video card artist name\">\n                                    Bruno Mars\n                                </span>\n                                <span class=\"ticket-card-source\" data-kid=\"1-1-2-5-2-1-2-3-2\" data-name=\"video card source name\">\n                                    YouTube video\n                                </span>\n                            </span>\n                        </button>\n                        <button aria-label=\"Show Harry Styles live preview\" aria-selected=\"false\" class=\"ticket-card\" data-dynamic=\"true\" data-kid=\"1-1-2-5-2-1-3\" data-name=\"video card\" data-reason=\"aria-selected and classList updated by script on interaction\" data-title=\"Harry Styles: Together, Together\" data-venue=\"Los Angeles · 2026\" data-video=\"N0ZUMWk6omY\" role=\"option\" type=\"button\">\n                            <span class=\"ticket-card-stub\" data-kid=\"1-1-2-5-2-1-3-1\" data-name=\"video card thumbnail container\">\n                                <img alt=\"\" data-kid=\"1-1-2-5-2-1-3-1-1\" data-name=\"video card thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/N0ZUMWk6omY/hqdefault.jpg\"/>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"ticket-card-seam\" data-kid=\"1-1-2-5-2-1-3-2\" data-name=\"video card separator seam\">\n                            </span>\n                            <span class=\"ticket-card-copy\" data-kid=\"1-1-2-5-2-1-3-3\" data-name=\"video card text container\">\n                                <span class=\"ticket-card-artist\" data-kid=\"1-1-2-5-2-1-3-3-1\" data-name=\"video card artist name\">\n                                    Harry Styles\n                                </span>\n                                <span class=\"ticket-card-source\" data-kid=\"1-1-2-5-2-1-3-3-2\" data-name=\"video card source name\">\n                                    YouTube video\n                                </span>\n                            </span>\n                        </button>\n                        <button aria-label=\"Show BTS live preview\" aria-selected=\"false\" class=\"ticket-card\" data-dynamic=\"true\" data-kid=\"1-1-2-5-2-1-4\" data-name=\"video card\" data-reason=\"aria-selected and classList updated by script on interaction\" data-title=\"BTS WORLD TOUR 'ARIRANG' IN LOS ANGELES\" data-venue=\"Los Angeles · 2026\" data-video=\"w54r_M6D0Lk\" role=\"option\" type=\"button\">\n                            <span class=\"ticket-card-stub\" data-kid=\"1-1-2-5-2-1-4-1\" data-name=\"video card thumbnail container\">\n                                <img alt=\"\" data-kid=\"1-1-2-5-2-1-4-1-1\" data-name=\"video card thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/w54r_M6D0Lk/hqdefault.jpg\"/>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"ticket-card-seam\" data-kid=\"1-1-2-5-2-1-4-2\" data-name=\"video card separator seam\">\n                            </span>\n                            <span class=\"ticket-card-copy\" data-kid=\"1-1-2-5-2-1-4-3\" data-name=\"video card text container\">\n                                <span class=\"ticket-card-artist\" data-kid=\"1-1-2-5-2-1-4-3-1\" data-name=\"video card artist name\">\n                                    BTS WORLD TOUR\n                                </span>\n                                <span class=\"ticket-card-source\" data-kid=\"1-1-2-5-2-1-4-3-2\" data-name=\"video card source name\">\n                                    YouTube video\n                                </span>\n                            </span>\n                        </button>\n                        <button aria-label=\"Show Zach Bryan live preview\" aria-selected=\"false\" class=\"ticket-card\" data-dynamic=\"true\" data-kid=\"1-1-2-5-2-1-5\" data-name=\"video card\" data-reason=\"aria-selected and classList updated by script on interaction\" data-title=\"Zach Bryan\" data-venue=\"US live desk\" data-video=\"xVP40kztbts\" role=\"option\" type=\"button\">\n                            <span class=\"ticket-card-stub\" data-kid=\"1-1-2-5-2-1-5-1\" data-name=\"video card thumbnail container\">\n                                <img alt=\"\" data-kid=\"1-1-2-5-2-1-5-1-1\" data-name=\"video card thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/xVP40kztbts/hqdefault.jpg\"/>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"ticket-card-seam\" data-kid=\"1-1-2-5-2-1-5-2\" data-name=\"video card separator seam\">\n                            </span>\n                            <span class=\"ticket-card-copy\" data-kid=\"1-1-2-5-2-1-5-3\" data-name=\"video card text container\">\n                                <span class=\"ticket-card-artist\" data-kid=\"1-1-2-5-2-1-5-3-1\" data-name=\"video card artist name\">\n                                    Zach Bryan\n                                </span>\n                                <span class=\"ticket-card-source\" data-kid=\"1-1-2-5-2-1-5-3-2\" data-name=\"video card source name\">\n                                    YouTube video\n                                </span>\n                            </span>\n                        </button>\n                        <button aria-label=\"Show Backstreet Boys live preview\" aria-selected=\"false\" class=\"ticket-card\" data-dynamic=\"true\" data-kid=\"1-1-2-5-2-1-6\" data-name=\"video card\" data-reason=\"aria-selected and classList updated by script on interaction\" data-title=\"Backstreet Boys: Into The Millennium\" data-venue=\"US live desk\" data-video=\"nqdMxE0fFDc\" role=\"option\" type=\"button\">\n                            <span class=\"ticket-card-stub\" data-kid=\"1-1-2-5-2-1-6-1\" data-name=\"video card thumbnail container\">\n                                <img alt=\"\" data-kid=\"1-1-2-5-2-1-6-1-1\" data-name=\"video card thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/nqdMxE0fFDc/hqdefault.jpg\"/>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"ticket-card-seam\" data-kid=\"1-1-2-5-2-1-6-2\" data-name=\"video card separator seam\">\n                            </span>\n                            <span class=\"ticket-card-copy\" data-kid=\"1-1-2-5-2-1-6-3\" data-name=\"video card text container\">\n                                <span class=\"ticket-card-artist\" data-kid=\"1-1-2-5-2-1-6-3-1\" data-name=\"video card artist name\">\n                                    Backstreet Boys\n                                </span>\n                                <span class=\"ticket-card-source\" data-kid=\"1-1-2-5-2-1-6-3-2\" data-name=\"video card source name\">\n                                    YouTube video\n                                </span>\n                            </span>\n                        </button>\n                        <button aria-label=\"Show Ed Sheeran live preview\" aria-selected=\"false\" class=\"ticket-card\" data-dynamic=\"true\" data-kid=\"1-1-2-5-2-1-7\" data-name=\"video card\" data-reason=\"aria-selected and classList updated by script on interaction\" data-title=\"Ed Sheeran: LOOP Tour\" data-venue=\"US live desk\" data-video=\"iWuPORCVclA\" role=\"option\" type=\"button\">\n                            <span class=\"ticket-card-stub\" data-kid=\"1-1-2-5-2-1-7-1\" data-name=\"video card thumbnail container\">\n                                <img alt=\"\" data-kid=\"1-1-2-5-2-1-7-1-1\" data-name=\"video card thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/iWuPORCVclA/hqdefault.jpg\"/>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"ticket-card-seam\" data-kid=\"1-1-2-5-2-1-7-2\" data-name=\"video card separator seam\">\n                            </span>\n                            <span class=\"ticket-card-copy\" data-kid=\"1-1-2-5-2-1-7-3\" data-name=\"video card text container\">\n                                <span class=\"ticket-card-artist\" data-kid=\"1-1-2-5-2-1-7-3-1\" data-name=\"video card artist name\">\n                                    Ed Sheeran\n                                </span>\n                                <span class=\"ticket-card-source\" data-kid=\"1-1-2-5-2-1-7-3-2\" data-name=\"video card source name\">\n                                    YouTube video\n                                </span>\n                            </span>\n                        </button>\n                        <button aria-label=\"Show Luke Bryan and Jason Aldean live preview\" aria-selected=\"false\" class=\"ticket-card\" data-dynamic=\"true\" data-kid=\"1-1-2-5-2-1-8\" data-name=\"video card\" data-reason=\"aria-selected and classList updated by script on interaction\" data-title=\"Luke Bryan & Jason Aldean: Double Down Tour 2026\" data-venue=\"US live desk\" data-video=\"r1AYY5hUPb4\" role=\"option\" type=\"button\">\n                            <span class=\"ticket-card-stub\" data-kid=\"1-1-2-5-2-1-8-1\" data-name=\"video card thumbnail container\">\n                                <img alt=\"\" data-kid=\"1-1-2-5-2-1-8-1-1\" data-name=\"video card thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.ytimg.com/vi/r1AYY5hUPb4/hqdefault.jpg\"/>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"ticket-card-seam\" data-kid=\"1-1-2-5-2-1-8-2\" data-name=\"video card separator seam\">\n                            </span>\n                            <span class=\"ticket-card-copy\" data-kid=\"1-1-2-5-2-1-8-3\" data-name=\"video card text container\">\n                                <span class=\"ticket-card-artist\" data-kid=\"1-1-2-5-2-1-8-3-1\" data-name=\"video card artist name\">\n                                    Luke Bryan & Jason Aldean\n                                </span>\n                                <span class=\"ticket-card-source\" data-kid=\"1-1-2-5-2-1-8-3-2\" data-name=\"video card source name\">\n                                    YouTube video\n                                </span>\n                            </span>\n                        </button>\n                    </div>\n                    <div aria-hidden=\"true\" class=\"ticket-rail-fade\" data-kid=\"1-1-2-5-2-2\" data-name=\"rail scroll fade container\">\n                        <i class=\"ti ti-chevron-left\" data-kid=\"1-1-2-5-2-2-1\" data-name=\"chevron left icon\">\n                        </i>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <p class=\"ticket-preview-description\" data-kid=\"1-1-3\" data-name=\"preview description text\">\n            Explore current live event schedules, verified ticket links and availability across the US. Buy official concert tickets for 2026 tours — every date is cross-checked against the promoter's schedule.\n        </p>\n    </main>\n</div>\n<script>\n    (() => {\n    const cards = Array.from(document.querySelectorAll('.ticket-card'));\n    const title = document.querySelector('[data-player-title]');\n    const venue = document.querySelector('[data-player-venue]');\n    const play = document.querySelector('.ticket-play');\n    cards.forEach((card) => {\n      card.addEventListener('click', () => {\n        cards.forEach((candidate) => {\n          const selected = candidate === card;\n          candidate.classList.toggle('is-active', selected);\n          candidate.setAttribute('aria-selected', String(selected));\n        });\n        if (title) title.textContent = card.dataset.title || '';\n        if (venue) venue.textContent = card.dataset.venue || 'US live desk';\n        if (play) play.setAttribute('aria-label', `Play ${card.querySelector('.ticket-card-artist')?.textContent || 'selected'} live preview`);\n      });\n    });\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-09-12T16:49:05.330581+00:00",
      "modified": "2026-09-12T16:50:19.049898+00:00",
